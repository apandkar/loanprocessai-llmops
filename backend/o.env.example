# Storage used on this laptop. Azure Blob Storage will replace this in Stage 2.
STORAGE_MODE=local

# First local smoke test. Do not commit the real key to this file.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Azure OpenAI configuration. Uncomment these and set LLM_PROVIDER=azure
# when ready to use your Azure deployment.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Azure Monitor Application Insights. Leave blank locally for JSON console logs.
# Set this as a Container Apps secret in Azure, not in source control.
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO

# Azure AI Search / RAG configuration. Use a query key for read-only search
# testing when possible; use Key Vault for cloud deployment secrets.
RAG_ENABLED=false
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_INDEX=YOUR-RAG-INDEX-NAME
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2024-07-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
RAG_TOP_K=5
